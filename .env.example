# Copy to .env and fill in. The app fails fast with a clear message if the
# selected provider's key is missing (API-key-only; there is no local fallback).

# ===== LLM (required) =====
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# Model id must be one your Groq key can access (see `client.models.list()`).
# Faster alternatives: openai/gpt-oss-20b (~0.5s/call) or qwen/qwen3.8-27b (~0.15s/call)
GROQ_MODEL=openai/gpt-oss-120b

# To use Google Gemini instead, switch the provider and set its key:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# ===== Data (optional) =====
# Defaults to the bundled SQLite DB. Point this at ANY SQLAlchemy URL to use
# your own database - the agent introspects the new schema automatically.
# DATABASE_URL=sqlite:///data/analytics.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# DATA_DICTIONARY_PATH=seed/data_dictionary.yml

# ===== Agent / guardrails (optional) =====
MAX_SQL_ROWS=1000
MAX_RETRIES=2
QUERY_TIMEOUT_SECONDS=15
ENABLE_CACHE=true

# ===== Observability (optional) =====
LOG_LEVEL=INFO
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
